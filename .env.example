# Copier ce fichier en .env.local et le remplir (ne jamais committer .env.local).

# URL publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clé secrète : serveur uniquement, contourne la RLS
SUPABASE_SECRET_KEY=sb_secret_xxx

# Multi-tenant (docs/multi-tenant.md) : les trois valeurs ci-dessus sont les mêmes pour tous les sites ;
# celle-ci identifie CE site (ligne de la table « sites », affichée par scripts/creer-site.mjs).
NEXT_PUBLIC_SITE_ID=00000000-0000-0000-0000-000000000000

# Secret partagé avec la tâche planifiée Vercel (/api/cron/purge)
CRON_SECRET=une-longue-chaine-aleatoire

# Sel pour hacher les adresses IP (limitation anti-spam)
RATE_LIMIT_SALT=une-autre-chaine-aleatoire

# E-mails de notification (https://resend.com). Sans ces deux valeurs, rien n'est envoyé.
RESEND_API_KEY=
EMAIL_FROM="Beth Habad de Montmagny <notifications@votre-domaine.fr>"

# Notifications sur le téléphone de l'équipe (Web Push). Sans ces clés, rien n'est envoyé.
# Générer une paire : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://votre-site.fr

# Tests de bout en bout (développement uniquement) : compte créé puis supprimé par scripts/e2e-admin.mjs
TEST_EDITOR_EMAIL=test-editeur@example.com
TEST_EDITOR_PASSWORD=un-mot-de-passe-long-et-aleatoire

# Mettre à 1 une fois le modèle d'e-mail de connexion personnalisé activé (il contient un code à saisir)
NEXT_PUBLIC_LOGIN_CODE_IN_EMAIL=0
